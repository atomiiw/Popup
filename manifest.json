{
  "manifest_version": 3,
  "name": "Popup - Ask inline follow-ups in ChatGPT",
  "version": "1.2.10",
  "version_name": "1.2.10-dev.2",
  "description": "Ask ChatGPT where questions come up. Highlight. Ask. Keep reading. Stay in your flow.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/early-hide.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/scroll-guard.js",
        "src/net-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "storage.js",
        "src/jr-namespace.js",
        "src/site-adapter.js",
        "src/qa-content.js",
        "src/dom-helpers.js",
        "src/text-extraction.js",
        "src/highlight.js",
        "src/chat.js",
        "src/popup-helpers.js",
        "src/popup.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/console-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
