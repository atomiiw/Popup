{
  "manifest_version": 3,
  "name": "Popup - Ask inline follow-ups in ChatGPT, DeepSeek and Claude",
  "version": "1.2.15",
  "description": "Ask where questions come up — in ChatGPT, DeepSeek and Claude. Highlight. Ask. Keep reading. Stay in your flow.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/site-hosts.js",
        "src/early-hide.js",
        "src/escape-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/scroll-guard.js",
        "src/net-tap.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "src/scroll-guard.js",
        "src/sites/deepseek-net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/scroll-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "storage.js",
        "src/jr-namespace.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "src/sites/deepseek.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/sites/claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/site-adapter.js",
        "src/qa-content.js",
        "src/availability.js",
        "src/send-outcome.js",
        "src/locator.js",
        "src/reach-turn.js",
        "src/site-overlay.js",
        "src/site-answer.js",
        "src/dom-helpers.js",
        "src/text-extraction.js",
        "src/highlight.js",
        "src/chat.js",
        "src/popup-helpers.js",
        "src/attachments.js",
        "src/popup.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/site-render.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/console-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
